[Unit]
Description=LovestGateWay settings and policy transactions
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /usr/local/lib/paopaogw/manage_web.py
Environment=TZ=UTC
Restart=on-failure
RestartSec=3
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# Full restore atomically replaces only BackupStore's fixed managed files.
# Replacing a file needs its parent writable, including the admin entry and units.
ReadWritePaths=/etc/paopaogw /var/lib/paopaogw /var/backups/paopaogw /usr/local/lib/paopaogw /usr/local/bin /etc/systemd/system
UMask=0077

[Install]
WantedBy=multi-user.target
